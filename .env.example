# Frontend (Vite) environment variables.
# Copy to `.env.local` (git-ignored) and fill in real values.
#
# IMPORTANT: any var prefixed with `VITE_` is inlined into the browser bundle
# and is PUBLIC. Only put client-safe values behind that prefix. Server/build
# secrets (like SENTRY_AUTH_TOKEN below) must NOT use the VITE_ prefix.

# ── Supabase (public anon key — safe client-side ONLY with RLS enabled) ──────
# The anon key is a low-privilege JWT. It is safe to ship to the browser ONLY
# because Row Level Security is enforced on every table + storage bucket (see
# SUPABASE_AUTH_SETUP.md). NEVER put the Supabase service_role key here or in
# any VITE_ var — it bypasses RLS and would expose the entire database.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Sentry error monitoring (optional) ───────────────────────────────────────
# The DSN is a public client key (safe to expose). Leave unset to disable.
VITE_SENTRY_DSN=https://your_key@your_org.ingest.sentry.io/your_project

# Accounts allowed to use the admin AI chat, comma-separated. Not a secret —
# access is still enforced server-side. Keep in sync with worker ADMIN_EMAILS.
VITE_ADMIN_EMAILS=you@example.com

# ── Build-time secret (NOT VITE_ prefixed → never sent to the browser) ────────
# Sentry auth token for uploading source maps at build time. Real secret —
# keep it only in .env.local, never commit it. Source-map upload is skipped
# entirely when this is unset. Get one at Sentry → Settings → Auth Tokens.
SENTRY_AUTH_TOKEN=sntrys_your_build_token
