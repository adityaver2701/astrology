# Copy to `.dev.vars` (git-ignored) and fill in real values for `wrangler dev`.
# In production these are set as secrets: `npx wrangler secret put <NAME>`.

# Groq free-tier key for AI readings (https://console.groq.com/keys).
# If unset, the worker falls back to Cloudflare Workers AI.
GROQ_API_KEY=gsk_your_key_here

# OPTIONAL: Claude API key for the admin-only chat (POST /api/chat).
# When unset, the chat uses the free Groq → Workers AI chain instead.
# Get one at https://platform.claude.com (paid, pay-as-you-go).
# ANTHROPIC_API_KEY=sk-ant-your_key_here
