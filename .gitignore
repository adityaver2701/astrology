# Frontend env files (never commit real keys) — keep only the .example template
.env
.env.*
!.env.example

# Wrangler local secrets (never commit API keys) + build cache/bundle output
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/

# Personal data — keep life-event timelines out of the repo
Life Events Timeline*.csv
public/life_events_timeline.csv

# Playwright
test-results/
playwright-report/

# ── Android / Capacitor ───────────────────────────────────────────────────
# `android/` is generated by `npx cap add android` and regenerated by
# `cap sync`. Commit it only if you hand-edit native files (custom Java,
# extra permissions); otherwise it's build output. Everything below MUST stay
# ignored either way — signing keys and local SDK paths must never be pushed.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/public/
android/app/release/
android/captures/
*.apk
*.aab

# Release signing — keystore and its passwords stay on your machine only
*.keystore
*.jks
keystore.properties
